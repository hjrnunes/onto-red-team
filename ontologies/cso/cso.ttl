@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cso: <http://taxonomy-refiner.io/ontologies/cso#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://taxonomy-refiner.io/ontologies/cso> a owl:Ontology ;
    dc:title "Content Safety Ontology" ;
    dc:creator "taxonomy-refiner project" ;
    owl:versionInfo "1.0.0" ;
    dc:rights "CC-BY 4.0" ;
    rdfs:comment "Lightweight ontology of content safety harm categories for adversarial prompt generation diversity." .

# Root Class

cso:ContentSafetyHazard a owl:Class ;
    rdfs:label "Content Safety Hazard" ;
    rdfs:comment "Root class for content safety harm categories relevant to adversarial prompt generation against LLM deployments." .

# Violence Category (29 classes)

cso:Violence a owl:Class ;
    rdfs:label "Violence" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Physical force intended to harm, damage, or kill living beings. Includes direct violence, threats, terrorism, and weapons-related harms." .

## PhysicalAssault subcategory

cso:PhysicalAssault a owl:Class ;
    rdfs:label "Physical Assault" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Intentional physical attack on a person causing or attempting to cause bodily harm." .

cso:AggravatedAssault a owl:Class ;
    rdfs:label "Aggravated Assault" ;
    rdfs:subClassOf cso:PhysicalAssault ;
    rdfs:comment "Physical assault involving a deadly weapon or resulting in serious bodily injury." .

cso:DomesticViolence a owl:Class ;
    rdfs:label "Domestic Violence" ;
    rdfs:subClassOf cso:PhysicalAssault ;
    rdfs:comment "Physical assault occurring within intimate partner, family, or household relationships." .

cso:AssaultAgainstMinors a owl:Class ;
    rdfs:label "Assault Against Minors" ;
    rdfs:subClassOf cso:PhysicalAssault ;
    rdfs:comment "Physical assault targeting individuals under 18 years of age." .

## Homicide subcategory

cso:Homicide a owl:Class ;
    rdfs:label "Homicide" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Intentional or unintentional killing of a human being by another human being." .

cso:Murder a owl:Class ;
    rdfs:label "Murder" ;
    rdfs:subClassOf cso:Homicide ;
    rdfs:comment "Unlawful premeditated killing of one human being by another with malice aforethought." .

cso:Manslaughter a owl:Class ;
    rdfs:label "Manslaughter" ;
    rdfs:subClassOf cso:Homicide ;
    rdfs:comment "Unlawful killing without premeditation or malice, including voluntary and involuntary forms." .

cso:Assassination a owl:Class ;
    rdfs:label "Assassination" ;
    rdfs:subClassOf cso:Homicide ;
    rdfs:comment "Targeted killing of a prominent individual for political, ideological, or financial motives." .

## MassViolence subcategory

cso:MassViolence a owl:Class ;
    rdfs:label "Mass Violence" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Acts of violence targeting multiple victims simultaneously or in rapid succession." .

cso:MassShooting a owl:Class ;
    rdfs:label "Mass Shooting" ;
    rdfs:subClassOf cso:MassViolence ;
    rdfs:comment "Shooting incident targeting multiple victims with firearms in a relatively confined area." .

cso:BombingAttack a owl:Class ;
    rdfs:label "Bombing Attack" ;
    rdfs:subClassOf cso:MassViolence ;
    rdfs:comment "Use of explosive devices to harm multiple victims and destroy property." .

cso:VehicularAttack a owl:Class ;
    rdfs:label "Vehicular Attack" ;
    rdfs:subClassOf cso:MassViolence ;
    rdfs:comment "Intentional use of a vehicle as a weapon to strike multiple pedestrians or targets." .

## Terrorism subcategory

cso:Terrorism a owl:Class ;
    rdfs:label "Terrorism" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Unlawful use of violence and intimidation against civilians to pursue political, ideological, or religious aims." .

cso:DomesticTerrorism a owl:Class ;
    rdfs:label "Domestic Terrorism" ;
    rdfs:subClassOf cso:Terrorism ;
    rdfs:comment "Terrorism conducted within a nation by individuals or groups based and operating in that country." .

cso:InternationalTerrorism a owl:Class ;
    rdfs:label "International Terrorism" ;
    rdfs:subClassOf cso:Terrorism ;
    rdfs:comment "Terrorism involving citizens or territory of more than one country or conducted by transnational organizations." .

cso:Cyberterrorism a owl:Class ;
    rdfs:label "Cyberterrorism" ;
    rdfs:subClassOf cso:Terrorism ;
    rdfs:comment "Use of digital attacks against critical infrastructure or information systems to create fear and disruption for political ends." .

## ThreatsOfViolence subcategory

cso:ThreatsOfViolence a owl:Class ;
    rdfs:label "Threats of Violence" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Communication of intent to inflict harm or damage to create fear, even if not carried out." .

cso:DeathThreat a owl:Class ;
    rdfs:label "Death Threat" ;
    rdfs:subClassOf cso:ThreatsOfViolence ;
    rdfs:comment "Explicit communication of intent to kill a specific individual or group." .

cso:Intimidation a owl:Class ;
    rdfs:label "Intimidation" ;
    rdfs:subClassOf cso:ThreatsOfViolence ;
    rdfs:comment "Use of threats or fear to coerce compliance or silence opposition without necessarily specifying lethal harm." .

cso:Stalking a owl:Class ;
    rdfs:label "Stalking" ;
    rdfs:subClassOf cso:ThreatsOfViolence ;
    rdfs:comment "Persistent unwanted attention and following of an individual creating reasonable fear for personal safety." .

## WeaponsUse subcategory

cso:WeaponsUse a owl:Class ;
    rdfs:label "Weapons Use" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Employment of instruments designed or adapted to inflict harm in acts of violence." .

cso:FirearmsUse a owl:Class ;
    rdfs:label "Firearms Use" ;
    rdfs:subClassOf cso:WeaponsUse ;
    rdfs:comment "Use of guns, rifles, or other projectile weapons that discharge bullets or pellets." .

cso:BladedWeaponsUse a owl:Class ;
    rdfs:label "Bladed Weapons Use" ;
    rdfs:subClassOf cso:WeaponsUse ;
    rdfs:comment "Use of knives, swords, machetes, or other cutting or stabbing implements." .

cso:ImprovisedWeaponsUse a owl:Class ;
    rdfs:label "Improvised Weapons Use" ;
    rdfs:subClassOf cso:WeaponsUse ;
    rdfs:comment "Use of everyday objects repurposed as weapons, such as bottles, tools, or furniture." .

cso:ExplosiveUse a owl:Class ;
    rdfs:label "Explosive Use" ;
    rdfs:subClassOf cso:WeaponsUse ;
    rdfs:comment "Use of bombs, grenades, or other devices that cause harm through explosive force and fragmentation." .

## Direct children of Violence

cso:Torture a owl:Class ;
    rdfs:label "Torture" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Intentional infliction of severe physical or psychological pain and suffering, often for coercion or punishment." .

cso:AnimalCruelty a owl:Class ;
    rdfs:label "Animal Cruelty" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Intentional harm, neglect, or abuse causing suffering to non-human animals." .

cso:GlorificationOfViolence a owl:Class ;
    rdfs:label "Glorification of Violence" ;
    rdfs:subClassOf cso:Violence ;
    rdfs:comment "Content that celebrates, praises, or portrays violent acts in a positive or heroic light, potentially encouraging imitation." .

# --- 2. Hate and Discrimination (26 classes) ---

cso:HateAndDiscrimination a owl:Class ;
    rdfs:label "Hate and Discrimination" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Content expressing hostility, prejudice, or bias against individuals or groups based on protected characteristics such as race, religion, gender, sexual orientation, disability, ethnicity, or age." .

## IdentityBasedHate subcategory

cso:IdentityBasedHate a owl:Class ;
    rdfs:label "Identity-Based Hate" ;
    rdfs:subClassOf cso:HateAndDiscrimination ;
    rdfs:comment "Hostility directed at individuals or groups based on specific protected identity characteristics." .

cso:RacialHate a owl:Class ;
    rdfs:label "Racial Hate" ;
    rdfs:subClassOf cso:IdentityBasedHate ;
    rdfs:comment "Hostility targeting individuals or groups based on race or perceived racial characteristics." .

cso:ReligiousHate a owl:Class ;
    rdfs:label "Religious Hate" ;
    rdfs:subClassOf cso:IdentityBasedHate ;
    rdfs:comment "Hostility targeting individuals or groups based on religious beliefs, practices, or affiliation." .

cso:GenderBasedHate a owl:Class ;
    rdfs:label "Gender-Based Hate" ;
    rdfs:subClassOf cso:IdentityBasedHate ;
    rdfs:comment "Hostility targeting individuals based on gender identity, including misogyny and transphobia." .

cso:AntiLGBTQHate a owl:Class ;
    rdfs:label "Anti-LGBTQ Hate" ;
    rdfs:subClassOf cso:IdentityBasedHate ;
    rdfs:comment "Hostility targeting individuals based on sexual orientation or gender identity, including homophobia and transphobia." .

cso:DisabilityBasedHate a owl:Class ;
    rdfs:label "Disability-Based Hate" ;
    rdfs:subClassOf cso:IdentityBasedHate ;
    rdfs:comment "Hostility targeting individuals with physical, cognitive, or mental disabilities." .

cso:EthnicHate a owl:Class ;
    rdfs:label "Ethnic Hate" ;
    rdfs:subClassOf cso:IdentityBasedHate ;
    rdfs:comment "Hostility targeting individuals or groups based on ethnic origin, nationality, or cultural heritage." .

cso:AgeBasedHate a owl:Class ;
    rdfs:label "Age-Based Hate" ;
    rdfs:subClassOf cso:IdentityBasedHate ;
    rdfs:comment "Hostility targeting individuals based on age, including ageism against elderly or young people." .

## Dehumanization subcategory

cso:Dehumanization a owl:Class ;
    rdfs:label "Dehumanization" ;
    rdfs:subClassOf cso:HateAndDiscrimination ;
    rdfs:comment "Content that denies the humanity or personhood of individuals or groups, often as a precursor to violence or severe discrimination." .

cso:DehumanizingComparison a owl:Class ;
    rdfs:label "Dehumanizing Comparison" ;
    rdfs:subClassOf cso:Dehumanization ;
    rdfs:comment "Comparing people to animals, objects, or diseases to strip them of human dignity and worth." .

cso:DenialOfHumanity a owl:Class ;
    rdfs:label "Denial of Humanity" ;
    rdfs:subClassOf cso:Dehumanization ;
    rdfs:comment "Explicit statements that certain individuals or groups are subhuman or lack fundamental human qualities." .

cso:EliminationistRhetoric a owl:Class ;
    rdfs:label "Eliminationist Rhetoric" ;
    rdfs:subClassOf cso:Dehumanization ;
    rdfs:comment "Language suggesting that a group should be removed, exterminated, or eliminated from society." .

## Harassment subcategory

cso:Harassment a owl:Class ;
    rdfs:label "Harassment" ;
    rdfs:subClassOf cso:HateAndDiscrimination ;
    rdfs:comment "Persistent, unwanted conduct that demeans, intimidates, or creates a hostile environment for targeted individuals or groups." .

cso:TargetedHarassment a owl:Class ;
    rdfs:label "Targeted Harassment" ;
    rdfs:subClassOf cso:Harassment ;
    rdfs:comment "Directed, repeated hostile behavior aimed at specific individuals based on their identity or activities." .

cso:CoordinatedHarassment a owl:Class ;
    rdfs:label "Coordinated Harassment" ;
    rdfs:subClassOf cso:Harassment ;
    rdfs:comment "Organized group efforts to harass an individual or community, often through swarming or brigading." .

cso:SexualHarassment a owl:Class ;
    rdfs:label "Sexual Harassment" ;
    rdfs:subClassOf cso:Harassment ;
    rdfs:comment "Unwanted sexual advances, requests for sexual favors, or other verbal or physical conduct of a sexual nature." .

cso:WorkplaceHarassment a owl:Class ;
    rdfs:label "Workplace Harassment" ;
    rdfs:subClassOf cso:Harassment ;
    rdfs:comment "Harassment occurring in professional settings that creates a hostile or intimidating work environment." .

## DiscriminatoryPractices subcategory

cso:DiscriminatoryPractices a owl:Class ;
    rdfs:label "Discriminatory Practices" ;
    rdfs:subClassOf cso:HateAndDiscrimination ;
    rdfs:comment "Systematic unfair treatment of individuals or groups based on protected characteristics in access to services, opportunities, or resources." .

cso:DiscriminatoryDenialOfService a owl:Class ;
    rdfs:label "Discriminatory Denial of Service" ;
    rdfs:subClassOf cso:DiscriminatoryPractices ;
    rdfs:comment "Refusal to provide goods, services, or access to facilities based on protected identity characteristics." .

cso:EmploymentDiscrimination a owl:Class ;
    rdfs:label "Employment Discrimination" ;
    rdfs:subClassOf cso:DiscriminatoryPractices ;
    rdfs:comment "Unfair treatment in hiring, promotion, compensation, or termination based on protected characteristics." .

cso:HousingDiscrimination a owl:Class ;
    rdfs:label "Housing Discrimination" ;
    rdfs:subClassOf cso:DiscriminatoryPractices ;
    rdfs:comment "Unfair denial of housing, rental opportunities, or mortgages based on protected identity characteristics." .

cso:AlgorithmicDiscrimination a owl:Class ;
    rdfs:label "Algorithmic Discrimination" ;
    rdfs:subClassOf cso:DiscriminatoryPractices ;
    rdfs:comment "Systematic bias in automated decision-making systems that disadvantages specific groups based on protected characteristics." .

## Direct children of HateAndDiscrimination

cso:SlursAndEpithets a owl:Class ;
    rdfs:label "Slurs and Epithets" ;
    rdfs:subClassOf cso:HateAndDiscrimination ;
    rdfs:comment "Derogatory terms, insults, or hate speech specifically targeting individuals or groups based on identity characteristics." .

cso:Stereotyping a owl:Class ;
    rdfs:label "Stereotyping" ;
    rdfs:subClassOf cso:HateAndDiscrimination ;
    rdfs:comment "Oversimplified, generalized beliefs about members of a group that deny individual variation and often perpetuate prejudice." .

cso:IncitementToHatred a owl:Class ;
    rdfs:label "Incitement to Hatred" ;
    rdfs:subClassOf cso:HateAndDiscrimination ;
    rdfs:comment "Content that deliberately provokes or encourages hostility, violence, or discrimination against a protected group." .

# --- 3. Self-Harm (17 classes) ---

cso:SelfHarm a owl:Class ;
    rdfs:label "Self-Harm" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Intentional injury to one's own body or mind without suicidal intent, including physical self-injury, disordered eating behaviors, and content that encourages or glorifies such acts." .

## SuicidalIdeation subcategory

cso:SuicidalIdeation a owl:Class ;
    rdfs:label "Suicidal Ideation" ;
    rdfs:subClassOf cso:SelfHarm ;
    rdfs:comment "Thoughts, fantasies, or planning related to ending one's own life, ranging from passive wishes to active preparations." .

cso:PassiveSuicidalIdeation a owl:Class ;
    rdfs:label "Passive Suicidal Ideation" ;
    rdfs:subClassOf cso:SuicidalIdeation ;
    rdfs:comment "Thoughts about death or wishing to be dead without active planning or intent to act on suicidal thoughts." .

cso:ActiveSuicidalPlanning a owl:Class ;
    rdfs:label "Active Suicidal Planning" ;
    rdfs:subClassOf cso:SuicidalIdeation ;
    rdfs:comment "Concrete planning and preparation for suicide, including method selection and timing considerations." .

## SuicideMethods subcategory

cso:SuicideMethods a owl:Class ;
    rdfs:label "Suicide Methods" ;
    rdfs:subClassOf cso:SelfHarm ;
    rdfs:comment "Information or instruction regarding specific means, techniques, or procedures for ending one's life." .

cso:SuicideMethodInstruction a owl:Class ;
    rdfs:label "Suicide Method Instruction" ;
    rdfs:subClassOf cso:SuicideMethods ;
    rdfs:comment "Detailed guidance on how to carry out suicide, including step-by-step procedures or recommendations for lethal means." .

cso:SuicidePactFacilitation a owl:Class ;
    rdfs:label "Suicide Pact Facilitation" ;
    rdfs:subClassOf cso:SuicideMethods ;
    rdfs:comment "Content that arranges, encourages, or coordinates group suicide agreements or collective self-harm acts." .

## NonSuicidalSelfInjury subcategory

cso:NonSuicidalSelfInjury a owl:Class ;
    rdfs:label "Non-Suicidal Self-Injury" ;
    rdfs:subClassOf cso:SelfHarm ;
    rdfs:comment "Intentional damage to one's own body tissue without suicidal intent, often as a maladaptive coping mechanism for emotional distress." .

cso:Cutting a owl:Class ;
    rdfs:label "Cutting" ;
    rdfs:subClassOf cso:NonSuicidalSelfInjury ;
    rdfs:comment "Intentional breaking of the skin using sharp objects such as razors, knives, or broken glass to inflict wounds." .

cso:Burning a owl:Class ;
    rdfs:label "Burning" ;
    rdfs:subClassOf cso:NonSuicidalSelfInjury ;
    rdfs:comment "Intentional application of heat or caustic substances to one's own skin causing tissue damage or scarring." .

cso:SelfPoisoning a owl:Class ;
    rdfs:label "Self-Poisoning" ;
    rdfs:subClassOf cso:NonSuicidalSelfInjury ;
    rdfs:comment "Intentional ingestion or exposure to toxic substances in sub-lethal doses as a form of self-harm rather than suicide attempt." .

## EatingDisorders subcategory

cso:EatingDisorders a owl:Class ;
    rdfs:label "Eating Disorders" ;
    rdfs:subClassOf cso:SelfHarm ;
    rdfs:comment "Content promoting, normalizing, or providing instruction for disordered eating behaviors and unhealthy relationships with food and body image." .

cso:AnorexiaPromotion a owl:Class ;
    rdfs:label "Anorexia Promotion" ;
    rdfs:subClassOf cso:EatingDisorders ;
    rdfs:comment "Content that encourages severe food restriction, starvation, or extreme weight loss as desirable or admirable behaviors." .

cso:BulimiaPromotion a owl:Class ;
    rdfs:label "Bulimia Promotion" ;
    rdfs:subClassOf cso:EatingDisorders ;
    rdfs:comment "Content that encourages binge eating followed by purging through vomiting, laxatives, or excessive exercise." .

cso:ProAnaContent a owl:Class ;
    rdfs:label "Pro-Ana Content" ;
    rdfs:subClassOf cso:EatingDisorders ;
    rdfs:comment "Content glorifying anorexia as a lifestyle choice rather than a disorder, often including tips, inspiration, and community support for disordered eating." .

## Direct children of SelfHarm

cso:SelfHarmGlorification a owl:Class ;
    rdfs:label "Self-Harm Glorification" ;
    rdfs:subClassOf cso:SelfHarm ;
    rdfs:comment "Content that celebrates, romanticizes, or portrays self-injurious behaviors in a positive light, potentially encouraging imitation." .

cso:SelfHarmCommunityFacilitation a owl:Class ;
    rdfs:label "Self-Harm Community Facilitation" ;
    rdfs:subClassOf cso:SelfHarm ;
    rdfs:comment "Content that creates or supports online spaces where individuals share methods, encourage each other's self-destructive behaviors, or normalize self-harm practices." .

# --- 4. Sexual Exploitation (22 classes) ---

cso:SexualExploitation a owl:Class ;
    rdfs:label "Sexual Exploitation" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Abuse of a position of vulnerability, power differential, or trust for sexual purposes, including trafficking, assault, non-consensual imagery, and exploitation of minors." .

## SexualAssault subcategory

cso:SexualAssault a owl:Class ;
    rdfs:label "Sexual Assault" ;
    rdfs:subClassOf cso:SexualExploitation ;
    rdfs:comment "Sexual contact or behavior that occurs without explicit consent of the victim, including physical force, coercion, or incapacitation." .

cso:Rape a owl:Class ;
    rdfs:label "Rape" ;
    rdfs:subClassOf cso:SexualAssault ;
    rdfs:comment "Non-consensual sexual penetration achieved through force, threat, or incapacitation of the victim." .

cso:DrugFacilitatedAssault a owl:Class ;
    rdfs:label "Drug-Facilitated Assault" ;
    rdfs:subClassOf cso:SexualAssault ;
    rdfs:comment "Sexual assault perpetrated against a victim who is incapacitated by alcohol or drugs, either voluntarily consumed or administered without knowledge." .

cso:CoercedSexualActs a owl:Class ;
    rdfs:label "Coerced Sexual Acts" ;
    rdfs:subClassOf cso:SexualAssault ;
    rdfs:comment "Sexual behavior obtained through psychological pressure, manipulation, threats, or abuse of authority rather than physical force." .

## ChildSexualExploitation subcategory

cso:ChildSexualExploitation a owl:Class ;
    rdfs:label "Child Sexual Exploitation" ;
    rdfs:subClassOf cso:SexualExploitation ;
    rdfs:comment "Sexual abuse and exploitation of individuals under the age of 18, including production of abuse material, grooming, trafficking, and sexualization." .

cso:CSAMProduction a owl:Class ;
    rdfs:label "CSAM Production" ;
    rdfs:subClassOf cso:ChildSexualExploitation ;
    rdfs:comment "Creation, distribution, or possession of child sexual abuse material depicting minors in sexually explicit situations." .

cso:ChildGrooming a owl:Class ;
    rdfs:label "Child Grooming" ;
    rdfs:subClassOf cso:ChildSexualExploitation ;
    rdfs:comment "Deliberate process of building trust and emotional connection with a minor to lower inhibitions and facilitate sexual abuse or exploitation." .

cso:MinorSexualization a owl:Class ;
    rdfs:label "Minor Sexualization" ;
    rdfs:subClassOf cso:ChildSexualExploitation ;
    rdfs:comment "Portrayal of children in sexualized contexts, poses, or clothing that frames them as objects of adult sexual interest." .

cso:ChildTrafficking a owl:Class ;
    rdfs:label "Child Trafficking" ;
    rdfs:subClassOf cso:ChildSexualExploitation ;
    rdfs:comment "Recruitment, transportation, or harboring of minors for sexual exploitation through force, fraud, or coercion." .

## SexTrafficking subcategory

cso:SexTrafficking a owl:Class ;
    rdfs:label "Sex Trafficking" ;
    rdfs:subClassOf cso:SexualExploitation ;
    rdfs:comment "Recruitment, harboring, transportation, or obtaining of individuals through force, fraud, or coercion for commercial sexual exploitation." .

cso:ForcedProstitution a owl:Class ;
    rdfs:label "Forced Prostitution" ;
    rdfs:subClassOf cso:SexTrafficking ;
    rdfs:comment "Coercion of individuals into providing sexual services for commercial exchange against their will through violence, threats, or debt bondage." .

cso:CommercialExploitation a owl:Class ;
    rdfs:label "Commercial Exploitation" ;
    rdfs:subClassOf cso:SexTrafficking ;
    rdfs:comment "Use of individuals in commercial sex industry contexts where economic profit is derived from their sexual exploitation under conditions of coercion or deception." .

## NonConsensualIntimateImagery subcategory

cso:NonConsensualIntimateImagery a owl:Class ;
    rdfs:label "Non-Consensual Intimate Imagery" ;
    rdfs:subClassOf cso:SexualExploitation ;
    rdfs:comment "Creation, distribution, or threat of distributing sexually explicit images or videos without the depicted individual's consent." .

cso:RevengePornography a owl:Class ;
    rdfs:label "Revenge Pornography" ;
    rdfs:subClassOf cso:NonConsensualIntimateImagery ;
    rdfs:comment "Distribution of intimate images or videos without consent, often following relationship breakdown, with intent to humiliate or harm the depicted individual." .

cso:DeepfakePornography a owl:Class ;
    rdfs:label "Deepfake Pornography" ;
    rdfs:subClassOf cso:NonConsensualIntimateImagery ;
    rdfs:comment "Creation of synthetic sexually explicit imagery or video using AI face-swapping or body-mapping technology without the depicted person's consent." .

cso:VoyeuristicContent a owl:Class ;
    rdfs:label "Voyeuristic Content" ;
    rdfs:subClassOf cso:NonConsensualIntimateImagery ;
    rdfs:comment "Imagery captured of individuals in private or intimate situations without their knowledge or consent, such as hidden camera recordings." .

## SexualExploitationHarassment subcategory

cso:SexualExploitationHarassment a owl:Class ;
    rdfs:label "Sexual Exploitation Harassment" ;
    rdfs:subClassOf cso:SexualExploitation ;
    rdfs:comment "Unwanted sexual contact, solicitation, or coercive demands for sexual material or acts, distinct from workplace or identity-based sexual harassment." .

cso:UnwantedSexualSolicitation a owl:Class ;
    rdfs:label "Unwanted Sexual Solicitation" ;
    rdfs:subClassOf cso:SexualExploitationHarassment ;
    rdfs:comment "Persistent or aggressive requests for sexual contact, images, or acts despite clear refusal or lack of consent." .

cso:Sextortion a owl:Class ;
    rdfs:label "Sextortion" ;
    rdfs:subClassOf cso:SexualExploitationHarassment ;
    rdfs:comment "Coercion of individuals into providing sexual images, videos, or acts under threat of releasing existing intimate material or causing other harm." .

## Direct children of SexualExploitation

cso:Bestiality a owl:Class ;
    rdfs:label "Bestiality" ;
    rdfs:subClassOf cso:SexualExploitation ;
    rdfs:comment "Sexual contact between humans and non-human animals, constituting animal abuse and often illegal sexual conduct." .

cso:SexualCoercion a owl:Class ;
    rdfs:label "Sexual Coercion" ;
    rdfs:subClassOf cso:SexualExploitation ;
    rdfs:comment "Use of pressure, manipulation, or exploitation of power imbalances to obtain sexual compliance without physical force or explicit threats." .

# --- 5. Sexual Content (11 classes) ---

cso:SexualContent a owl:Class ;
    rdfs:label "Sexual Content" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Content involving sexual themes, behaviors, descriptions, or imagery that may be inappropriate, explicit, or boundary-crossing in certain contexts, distinct from exploitative content involving coercion or minors." .

cso:ExplicitSexualDescription a owl:Class ;
    rdfs:label "Explicit Sexual Description" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Detailed, graphic descriptions of sexual acts, anatomy, or behaviors that leave little to interpretation." .

cso:EroticFictionGeneration a owl:Class ;
    rdfs:label "Erotic Fiction Generation" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Creation of narrative content primarily designed to sexually arouse the reader through fictional scenarios and characters." .

cso:SexualFetishContent a owl:Class ;
    rdfs:label "Sexual Fetish Content" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Content focused on atypical sexual interests or practices that may be considered niche, taboo, or inappropriate in mainstream contexts." .

cso:PornographicContentDescription a owl:Class ;
    rdfs:label "Pornographic Content Description" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Descriptions or generation of explicit sexual material intended for sexual arousal, mimicking pornographic media formats." .

cso:SexualRolePlay a owl:Class ;
    rdfs:label "Sexual Role Play" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Interactive scenarios where participants adopt sexual personas or engage in sexually charged conversational exchanges." .

cso:SexEducationBoundary a owl:Class ;
    rdfs:label "Sex Education Boundary" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Content that crosses from informational sex education into inappropriate detail, age-inappropriate framing, or instructional material for sexual activity." .

cso:ReproductiveHealthBoundary a owl:Class ;
    rdfs:label "Reproductive Health Boundary" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Medical or health information about reproduction that becomes overly detailed, graphically explicit, or inappropriate for the context or audience." .

cso:ClinicalSexualDescription a owl:Class ;
    rdfs:label "Clinical Sexual Description" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Medically accurate sexual content presented in contexts where clinical framing does not justify the level of detail or explicitness provided." .

cso:NudityDescription a owl:Class ;
    rdfs:label "Nudity Description" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Detailed descriptions of nude bodies or partial nudity, particularly when sexualized or presented in non-artistic contexts." .

cso:SexualInnuendo a owl:Class ;
    rdfs:label "Sexual Innuendo" ;
    rdfs:subClassOf cso:SexualContent ;
    rdfs:comment "Indirect or suggestive references to sexual acts or themes, often using double meanings or metaphors to imply sexual content." .

# --- 6. Fraud and Deception (29 classes) ---

cso:FraudAndDeception a owl:Class ;
    rdfs:label "Fraud and Deception" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Deliberate misrepresentation, manipulation, or false information intended to deceive individuals for personal gain, harm others, or undermine trust in institutions and information." .

## FinancialFraud subcategory

cso:FinancialFraud a owl:Class ;
    rdfs:label "Financial Fraud" ;
    rdfs:subClassOf cso:FraudAndDeception ;
    rdfs:comment "Deceptive practices designed to secure unlawful financial gain through misrepresentation of investment opportunities, identity theft, or manipulation of financial systems." .

cso:InvestmentScam a owl:Class ;
    rdfs:label "Investment Scam" ;
    rdfs:subClassOf cso:FinancialFraud ;
    rdfs:comment "Fraudulent schemes promising high returns with little risk to persuade victims to invest money in non-existent or worthless ventures." .

cso:PonziScheme a owl:Class ;
    rdfs:label "Ponzi Scheme" ;
    rdfs:subClassOf cso:FinancialFraud ;
    rdfs:comment "Investment fraud where returns to earlier investors are paid using capital from new investors rather than legitimate profits, creating unsustainable pyramid structure." .

cso:InsuranceFraud a owl:Class ;
    rdfs:label "Insurance Fraud" ;
    rdfs:subClassOf cso:FinancialFraud ;
    rdfs:comment "Deliberate deception in insurance transactions, including false claims, staged accidents, or misrepresentation of facts to obtain unwarranted payouts." .

cso:CreditCardFraud a owl:Class ;
    rdfs:label "Credit Card Fraud" ;
    rdfs:subClassOf cso:FinancialFraud ;
    rdfs:comment "Unauthorized use of credit card information to make purchases, withdraw funds, or conduct transactions without the cardholder's consent." .

cso:IdentityTheft a owl:Class ;
    rdfs:label "Identity Theft" ;
    rdfs:subClassOf cso:FinancialFraud ;
    rdfs:comment "Fraudulent acquisition and use of another person's identifying information, such as Social Security numbers or financial account details, for economic gain." .

## SocialEngineeringFraud subcategory

cso:SocialEngineeringFraud a owl:Class ;
    rdfs:label "Social Engineering Fraud" ;
    rdfs:subClassOf cso:FraudAndDeception ;
    rdfs:comment "Manipulation of individuals through psychological tactics to gain trust, extract confidential information, or persuade victims to take actions against their interests." .

cso:RomanceScam a owl:Class ;
    rdfs:label "Romance Scam" ;
    rdfs:subClassOf cso:SocialEngineeringFraud ;
    rdfs:comment "Fraudulent cultivation of romantic relationships online to exploit emotional vulnerability and extract money or sensitive information from victims." .

cso:Impersonation a owl:Class ;
    rdfs:label "Impersonation" ;
    rdfs:subClassOf cso:SocialEngineeringFraud ;
    rdfs:comment "Fraudulent assumption of another person's identity, including authority figures, celebrities, or trusted contacts, to deceive victims and gain compliance." .

cso:Pretexting a owl:Class ;
    rdfs:label "Pretexting" ;
    rdfs:subClassOf cso:SocialEngineeringFraud ;
    rdfs:comment "Creation of fabricated scenarios or false identities to manipulate targets into divulging confidential information or performing actions they would not otherwise take." .

cso:ConfidenceTrick a owl:Class ;
    rdfs:label "Confidence Trick" ;
    rdfs:subClassOf cso:SocialEngineeringFraud ;
    rdfs:comment "Exploiting the confidence and trust of victims through persuasive deception and manipulation to obtain money, property, or sensitive information." .

## Misinformation subcategory

cso:Misinformation a owl:Class ;
    rdfs:label "Misinformation" ;
    rdfs:subClassOf cso:FraudAndDeception ;
    rdfs:comment "False or inaccurate information shared without malicious intent to deceive, often due to misunderstanding, carelessness, or lack of fact-checking." .

cso:HealthMisinformation a owl:Class ;
    rdfs:label "Health Misinformation" ;
    rdfs:subClassOf cso:Misinformation ;
    rdfs:comment "Inaccurate medical or health-related claims that may lead individuals to make harmful decisions about their care, treatment, or public health measures." .

cso:PoliticalMisinformation a owl:Class ;
    rdfs:label "Political Misinformation" ;
    rdfs:subClassOf cso:Misinformation ;
    rdfs:comment "False information about political figures, policies, or events that distorts public understanding of governance and democratic processes." .

cso:ScientificMisinformation a owl:Class ;
    rdfs:label "Scientific Misinformation" ;
    rdfs:subClassOf cso:Misinformation ;
    rdfs:comment "Inaccurate claims about scientific findings, research methods, or consensus that undermine evidence-based understanding of natural phenomena." .

cso:ElectionMisinformation a owl:Class ;
    rdfs:label "Election Misinformation" ;
    rdfs:subClassOf cso:Misinformation ;
    rdfs:comment "False information about voting procedures, candidate eligibility, election results, or electoral integrity that may suppress participation or erode trust." .

## Disinformation subcategory

cso:Disinformation a owl:Class ;
    rdfs:label "Disinformation" ;
    rdfs:subClassOf cso:FraudAndDeception ;
    rdfs:comment "Deliberately false information spread with malicious intent to deceive, manipulate public opinion, or cause harm to individuals, groups, or institutions." .

cso:StateSponsoredPropaganda a owl:Class ;
    rdfs:label "State-Sponsored Propaganda" ;
    rdfs:subClassOf cso:Disinformation ;
    rdfs:comment "Coordinated spread of biased or false information by government actors to shape public opinion, justify policies, or undermine adversaries." .

cso:ConspiracyTheoryPromotion a owl:Class ;
    rdfs:label "Conspiracy Theory Promotion" ;
    rdfs:subClassOf cso:Disinformation ;
    rdfs:comment "Deliberate amplification of unsubstantiated explanations for events that attribute them to secret plots by powerful actors, eroding trust in legitimate institutions." .

cso:DeepfakeDisinformation a owl:Class ;
    rdfs:label "Deepfake Disinformation" ;
    rdfs:subClassOf cso:Disinformation ;
    rdfs:comment "Use of AI-generated synthetic media depicting individuals saying or doing things they did not, created intentionally to deceive and manipulate audiences." .

## Manipulation subcategory

cso:Manipulation a owl:Class ;
    rdfs:label "Manipulation" ;
    rdfs:subClassOf cso:FraudAndDeception ;
    rdfs:comment "Psychological tactics used to influence or control others' thoughts, emotions, or behaviors through deceptive or underhanded means for personal advantage." .

cso:EmotionalManipulation a owl:Class ;
    rdfs:label "Emotional Manipulation" ;
    rdfs:subClassOf cso:Manipulation ;
    rdfs:comment "Exploitation of emotional vulnerabilities through guilt, fear, or affection to control behavior or extract concessions from targets." .

cso:Gaslighting a owl:Class ;
    rdfs:label "Gaslighting" ;
    rdfs:subClassOf cso:Manipulation ;
    rdfs:comment "Systematic psychological manipulation causing victims to question their own perception, memory, or sanity to maintain control or avoid accountability." .

cso:CoerciveControl a owl:Class ;
    rdfs:label "Coercive Control" ;
    rdfs:subClassOf cso:Manipulation ;
    rdfs:comment "Pattern of behavior that seeks to dominate another person through isolation, intimidation, degradation, and control over resources or decision-making." .

## Counterfeiting subcategory

cso:Counterfeiting a owl:Class ;
    rdfs:label "Counterfeiting" ;
    rdfs:subClassOf cso:FraudAndDeception ;
    rdfs:comment "Creation and distribution of fraudulent imitations of documents, currency, or goods with intent to deceive about authenticity or legitimacy." .

cso:DocumentForgery a owl:Class ;
    rdfs:label "Document Forgery" ;
    rdfs:subClassOf cso:Counterfeiting ;
    rdfs:comment "Creation or alteration of documents such as identification papers, contracts, or credentials to fraudulently represent authorization, identity, or authenticity." .

cso:CurrencyCounterfeiting a owl:Class ;
    rdfs:label "Currency Counterfeiting" ;
    rdfs:subClassOf cso:Counterfeiting ;
    rdfs:comment "Production of fake money or financial instruments designed to pass as legitimate currency and defraud economic systems or individuals." .

## Direct child of FraudAndDeception

cso:AcademicDishonesty a owl:Class ;
    rdfs:label "Academic Dishonesty" ;
    rdfs:subClassOf cso:FraudAndDeception ;
    rdfs:comment "Deceptive practices in academic contexts, including plagiarism, cheating on examinations, fabrication of research data, or unauthorized collaboration." .

# --- 7. Dangerous Information (18 classes) ---

cso:DangerousInformation a owl:Class ;
    rdfs:label "Dangerous Information" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Knowledge or instructions that enable serious physical harm, weapons production, or dangerous activities when acquired or executed by untrained individuals outside regulated contexts." .

## WeaponsManufacturing subcategory

cso:WeaponsManufacturing a owl:Class ;
    rdfs:label "Weapons Manufacturing" ;
    rdfs:subClassOf cso:DangerousInformation ;
    rdfs:comment "Instructions or technical specifications for creating lethal weapons from raw materials or accessible components." .

cso:FirearmsManufacturing a owl:Class ;
    rdfs:label "Firearms Manufacturing" ;
    rdfs:subClassOf cso:WeaponsManufacturing ;
    rdfs:comment "Detailed instructions for constructing functional guns, including component machining, assembly procedures, and ammunition creation." .

cso:ExplosiveSynthesis a owl:Class ;
    rdfs:label "Explosive Synthesis" ;
    rdfs:subClassOf cso:WeaponsManufacturing ;
    rdfs:comment "Chemical formulas and procedures for creating explosive compounds or devices from precursor materials." .

cso:ChemicalWeaponsSynthesis a owl:Class ;
    rdfs:label "Chemical Weapons Synthesis" ;
    rdfs:subClassOf cso:WeaponsManufacturing ;
    rdfs:comment "Methods for producing toxic chemical agents designed to incapacitate, injure, or kill through inhalation, ingestion, or skin contact." .

## DrugSynthesis subcategory

cso:DrugSynthesis a owl:Class ;
    rdfs:label "Drug Synthesis" ;
    rdfs:subClassOf cso:DangerousInformation ;
    rdfs:comment "Detailed instructions for manufacturing controlled substances or illegal drugs from precursor chemicals or natural sources." .

cso:IllicitDrugManufacturing a owl:Class ;
    rdfs:label "Illicit Drug Manufacturing" ;
    rdfs:subClassOf cso:DrugSynthesis ;
    rdfs:comment "Step-by-step procedures for synthesizing illegal drugs such as methamphetamine, fentanyl, or synthetic cannabinoids." .

cso:PrecursorChemicalAcquisition a owl:Class ;
    rdfs:label "Precursor Chemical Acquisition" ;
    rdfs:subClassOf cso:DrugSynthesis ;
    rdfs:comment "Guidance on obtaining regulated chemical precursors required for drug synthesis while evading legal controls or detection." .

cso:DrugAdministrationMethods a owl:Class ;
    rdfs:label "Drug Administration Methods" ;
    rdfs:subClassOf cso:DrugSynthesis ;
    rdfs:comment "Instructions on routes of administration, dosing, or preparation techniques that maximize potency or minimize detection of illicit substances." .

## CBRNInformation subcategory

cso:CBRNInformation a owl:Class ;
    rdfs:label "CBRN Information" ;
    rdfs:subClassOf cso:DangerousInformation ;
    rdfs:comment "Knowledge about chemical, biological, radiological, or nuclear materials and weapons that could enable mass casualty attacks." .

cso:BiologicalAgentProduction a owl:Class ;
    rdfs:label "Biological Agent Production" ;
    rdfs:subClassOf cso:CBRNInformation ;
    rdfs:comment "Methods for culturing, weaponizing, or disseminating pathogens or toxins intended to cause disease or death in populations." .

cso:RadiologicalDeviceConstruction a owl:Class ;
    rdfs:label "Radiological Device Construction" ;
    rdfs:subClassOf cso:CBRNInformation ;
    rdfs:comment "Instructions for building dirty bombs or other devices that disperse radioactive material to contaminate areas and cause radiation exposure." .

cso:NuclearMaterialAcquisition a owl:Class ;
    rdfs:label "Nuclear Material Acquisition" ;
    rdfs:subClassOf cso:CBRNInformation ;
    rdfs:comment "Guidance on obtaining, enriching, or weaponizing fissile materials for nuclear weapons or radiological dispersal devices." .

## HarmfulHowTo subcategory

cso:HarmfulHowTo a owl:Class ;
    rdfs:label "Harmful How-To" ;
    rdfs:subClassOf cso:DangerousInformation ;
    rdfs:comment "Step-by-step instructions for activities that cause property destruction, physical harm, or enable illegal intrusion when executed by unauthorized individuals." .

cso:LockPickingAndBypassing a owl:Class ;
    rdfs:label "Lock Picking and Bypassing" ;
    rdfs:subClassOf cso:HarmfulHowTo ;
    rdfs:comment "Detailed techniques for defeating physical security locks, alarms, or access controls to enable unauthorized entry into protected spaces." .

cso:SabotageInstructions a owl:Class ;
    rdfs:label "Sabotage Instructions" ;
    rdfs:subClassOf cso:HarmfulHowTo ;
    rdfs:comment "Methods for disabling, damaging, or destroying infrastructure, equipment, or systems to cause operational disruption or economic harm." .

cso:ArsonMethods a owl:Class ;
    rdfs:label "Arson Methods" ;
    rdfs:subClassOf cso:HarmfulHowTo ;
    rdfs:comment "Instructions on accelerants, ignition techniques, or fire-setting strategies designed to maximize damage while minimizing detection or suppression." .

## Direct child of DangerousInformation

cso:DualUseResearchConcern a owl:Class ;
    rdfs:label "Dual-Use Research Concern" ;
    rdfs:subClassOf cso:DangerousInformation ;
    rdfs:comment "Scientific or technical information with legitimate research applications that could also be misused to develop biological weapons, enhance pathogen virulence, or enable mass harm." .

# --- 8. Intellectual Property (18 classes) ---

cso:IntellectualProperty a owl:Class ;
    rdfs:label "Intellectual Property" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Unauthorized use, reproduction, or distribution of protected creative works, inventions, brands, or confidential business information in violation of legal rights." .

## CopyrightInfringement subcategory

cso:CopyrightInfringement a owl:Class ;
    rdfs:label "Copyright Infringement" ;
    rdfs:subClassOf cso:IntellectualProperty ;
    rdfs:comment "Unauthorized reproduction, distribution, or public display of protected creative works such as literature, music, software, or visual art without permission from rights holders." .

cso:LiteraryWorkReproduction a owl:Class ;
    rdfs:label "Literary Work Reproduction" ;
    rdfs:subClassOf cso:CopyrightInfringement ;
    rdfs:comment "Verbatim copying or substantial reproduction of novels, poems, articles, or other written works protected by copyright." .

cso:MusicalWorkReproduction a owl:Class ;
    rdfs:label "Musical Work Reproduction" ;
    rdfs:subClassOf cso:CopyrightInfringement ;
    rdfs:comment "Unauthorized copying of song lyrics, melodies, compositions, or recordings protected by copyright law." .

cso:SoftwareCodeReproduction a owl:Class ;
    rdfs:label "Software Code Reproduction" ;
    rdfs:subClassOf cso:CopyrightInfringement ;
    rdfs:comment "Copying or distributing proprietary source code, compiled programs, or software components without license or permission." .

cso:VisualArtReproduction a owl:Class ;
    rdfs:label "Visual Art Reproduction" ;
    rdfs:subClassOf cso:CopyrightInfringement ;
    rdfs:comment "Unauthorized reproduction of paintings, photographs, illustrations, sculptures, or other visual works protected by copyright." .

cso:DatabaseExtraction a owl:Class ;
    rdfs:label "Database Extraction" ;
    rdfs:subClassOf cso:CopyrightInfringement ;
    rdfs:comment "Systematic extraction or reuse of substantial portions of databases protected under copyright or sui generis database rights." .

## TrademarkViolation subcategory

cso:TrademarkViolation a owl:Class ;
    rdfs:label "Trademark Violation" ;
    rdfs:subClassOf cso:IntellectualProperty ;
    rdfs:comment "Unauthorized use of protected brand names, logos, slogans, or trade dress in ways that cause consumer confusion or dilute brand value." .

cso:BrandNameMisuse a owl:Class ;
    rdfs:label "Brand Name Misuse" ;
    rdfs:subClassOf cso:TrademarkViolation ;
    rdfs:comment "Unauthorized use of protected brand names or trademarks in commercial contexts that create likelihood of confusion about source or affiliation." .

cso:LogoReproduction a owl:Class ;
    rdfs:label "Logo Reproduction" ;
    rdfs:subClassOf cso:TrademarkViolation ;
    rdfs:comment "Copying or displaying protected logos, symbols, or graphical marks without authorization from trademark holders." .

cso:TradeDressImitation a owl:Class ;
    rdfs:label "Trade Dress Imitation" ;
    rdfs:subClassOf cso:TrademarkViolation ;
    rdfs:comment "Copying the distinctive visual appearance, packaging, or presentation of products in ways that confuse consumers about origin or affiliation." .

## TradeSecretDisclosure subcategory

cso:TradeSecretDisclosure a owl:Class ;
    rdfs:label "Trade Secret Disclosure" ;
    rdfs:subClassOf cso:IntellectualProperty ;
    rdfs:comment "Unauthorized revelation of confidential business information such as formulas, processes, customer lists, or proprietary methods that provide competitive advantage." .

cso:FormulaDisclosure a owl:Class ;
    rdfs:label "Formula Disclosure" ;
    rdfs:subClassOf cso:TradeSecretDisclosure ;
    rdfs:comment "Revealing proprietary chemical formulas, recipes, or compound specifications protected as trade secrets." .

cso:ProcessDisclosure a owl:Class ;
    rdfs:label "Process Disclosure" ;
    rdfs:subClassOf cso:TradeSecretDisclosure ;
    rdfs:comment "Disclosing confidential manufacturing processes, business methods, or operational procedures that constitute trade secrets." .

cso:CustomerListDisclosure a owl:Class ;
    rdfs:label "Customer List Disclosure" ;
    rdfs:subClassOf cso:TradeSecretDisclosure ;
    rdfs:comment "Revealing confidential customer databases, contact information, or client relationship details protected as trade secrets." .

## Plagiarism subcategory

cso:Plagiarism a owl:Class ;
    rdfs:label "Plagiarism" ;
    rdfs:subClassOf cso:IntellectualProperty ;
    rdfs:comment "Presenting another person's ideas, words, or creative work as one's own without proper attribution or acknowledgment." .

cso:AcademicPlagiarism a owl:Class ;
    rdfs:label "Academic Plagiarism" ;
    rdfs:subClassOf cso:Plagiarism ;
    rdfs:comment "Copying or paraphrasing academic research, essays, or scholarly work without citation in educational or research contexts." .

cso:CreativePlagiarism a owl:Class ;
    rdfs:label "Creative Plagiarism" ;
    rdfs:subClassOf cso:Plagiarism ;
    rdfs:comment "Appropriating artistic concepts, storylines, designs, or creative expressions from others and presenting them as original work." .

# --- 9. Privacy Violation (23 classes) ---

cso:PrivacyViolation a owl:Class ;
    rdfs:label "Privacy Violation" ;
    rdfs:subClassOf cso:ContentSafetyHazard ;
    rdfs:comment "Unauthorized collection, disclosure, or use of personal information that compromises individual privacy, exposes sensitive data, or enables identity theft or discrimination." .

## DirectIdentifierExposure subcategory

cso:DirectIdentifierExposure a owl:Class ;
    rdfs:label "Direct Identifier Exposure" ;
    rdfs:subClassOf cso:PrivacyViolation ;
    rdfs:comment "Disclosure of information that directly identifies individuals, such as names, addresses, government identifiers, or biometric data." .

cso:NameAndAddressExposure a owl:Class ;
    rdfs:label "Name and Address Exposure" ;
    rdfs:subClassOf cso:DirectIdentifierExposure ;
    rdfs:comment "Revealing individuals' full names combined with residential or business addresses without authorization." .

cso:NationalIDExposure a owl:Class ;
    rdfs:label "National ID Exposure" ;
    rdfs:subClassOf cso:DirectIdentifierExposure ;
    rdfs:comment "Disclosing government-issued identification numbers such as Social Security numbers, passport numbers, or national identity card numbers." .

cso:BiometricDataExposure a owl:Class ;
    rdfs:label "Biometric Data Exposure" ;
    rdfs:subClassOf cso:DirectIdentifierExposure ;
    rdfs:comment "Revealing unique biological characteristics such as fingerprints, facial recognition data, iris scans, or DNA profiles used for identification." .

cso:PhotoAndLikenessExposure a owl:Class ;
    rdfs:label "Photo and Likeness Exposure" ;
    rdfs:subClassOf cso:DirectIdentifierExposure ;
    rdfs:comment "Unauthorized disclosure of photographs or visual representations of individuals in contexts that violate privacy expectations or consent." .

## FinancialDataExposure subcategory

cso:FinancialDataExposure a owl:Class ;
    rdfs:label "Financial Data Exposure" ;
    rdfs:subClassOf cso:PrivacyViolation ;
    rdfs:comment "Disclosure of personal financial information including account numbers, credit scores, or transaction histories without authorization." .

cso:AccountNumberExposure a owl:Class ;
    rdfs:label "Account Number Exposure" ;
    rdfs:subClassOf cso:FinancialDataExposure ;
    rdfs:comment "Revealing bank account numbers, credit card numbers, or other financial account identifiers that enable unauthorized access or fraud." .

cso:CreditScoreExposure a owl:Class ;
    rdfs:label "Credit Score Exposure" ;
    rdfs:subClassOf cso:FinancialDataExposure ;
    rdfs:comment "Disclosing individuals' credit ratings, creditworthiness assessments, or detailed credit reports without consent." .

cso:TransactionHistoryExposure a owl:Class ;
    rdfs:label "Transaction History Exposure" ;
    rdfs:subClassOf cso:FinancialDataExposure ;
    rdfs:comment "Revealing detailed records of financial transactions, purchases, payments, or account activity that expose spending patterns or financial behavior." .

## HealthDataExposure subcategory

cso:HealthDataExposure a owl:Class ;
    rdfs:label "Health Data Exposure" ;
    rdfs:subClassOf cso:PrivacyViolation ;
    rdfs:comment "Unauthorized disclosure of protected health information including medical records, diagnoses, treatments, or prescription histories." .

cso:MedicalRecordExposure a owl:Class ;
    rdfs:label "Medical Record Exposure" ;
    rdfs:subClassOf cso:HealthDataExposure ;
    rdfs:comment "Revealing comprehensive medical history, treatment records, test results, or clinical notes protected under healthcare privacy laws." .

cso:PrescriptionExposure a owl:Class ;
    rdfs:label "Prescription Exposure" ;
    rdfs:subClassOf cso:HealthDataExposure ;
    rdfs:comment "Disclosing information about medications prescribed to individuals, including drug names, dosages, or pharmacy records." .

cso:DiagnosisExposure a owl:Class ;
    rdfs:label "Diagnosis Exposure" ;
    rdfs:subClassOf cso:HealthDataExposure ;
    rdfs:comment "Revealing medical diagnoses, health conditions, or disease status that individuals expect to remain confidential." .

## DigitalFootprintExposure subcategory

cso:DigitalFootprintExposure a owl:Class ;
    rdfs:label "Digital Footprint Exposure" ;
    rdfs:subClassOf cso:PrivacyViolation ;
    rdfs:comment "Disclosure of digital behavior traces such as browsing history, location data, communication patterns, or device identifiers that reveal personal habits and associations." .

cso:BrowsingHistoryExposure a owl:Class ;
    rdfs:label "Browsing History Exposure" ;
    rdfs:subClassOf cso:DigitalFootprintExposure ;
    rdfs:comment "Revealing websites visited, search queries, or online activity patterns that expose interests, beliefs, or behaviors individuals expect to remain private." .

cso:LocationDataExposure a owl:Class ;
    rdfs:label "Location Data Exposure" ;
    rdfs:subClassOf cso:DigitalFootprintExposure ;
    rdfs:comment "Disclosing GPS coordinates, travel patterns, or location histories that reveal where individuals live, work, or spend time." .

cso:CommunicationMetadataExposure a owl:Class ;
    rdfs:label "Communication Metadata Exposure" ;
    rdfs:subClassOf cso:DigitalFootprintExposure ;
    rdfs:comment "Revealing who individuals communicate with, when, and how frequently, even without content of messages, exposing social networks and relationships." .

cso:DeviceFingerprintExposure a owl:Class ;
    rdfs:label "Device Fingerprint Exposure" ;
    rdfs:subClassOf cso:DigitalFootprintExposure ;
    rdfs:comment "Disclosing unique device identifiers, hardware configurations, or technical characteristics used to track individuals across platforms and contexts." .

## EmploymentDataExposure subcategory

cso:EmploymentDataExposure a owl:Class ;
    rdfs:label "Employment Data Exposure" ;
    rdfs:subClassOf cso:PrivacyViolation ;
    rdfs:comment "Unauthorized disclosure of employment information including compensation, performance evaluations, or workplace records that individuals expect to remain confidential." .

cso:SalaryExposure a owl:Class ;
    rdfs:label "Salary Exposure" ;
    rdfs:subClassOf cso:EmploymentDataExposure ;
    rdfs:comment "Revealing compensation details, wage information, bonuses, or benefits packages that employees expect to remain private." .

cso:PerformanceRecordExposure a owl:Class ;
    rdfs:label "Performance Record Exposure" ;
    rdfs:subClassOf cso:EmploymentDataExposure ;
    rdfs:comment "Disclosing employee evaluations, disciplinary actions, or performance metrics without authorization." .

## Direct child of PrivacyViolation

cso:UnauthorizedSurveillance a owl:Class ;
    rdfs:label "Unauthorized Surveillance" ;
    rdfs:subClassOf cso:PrivacyViolation ;
    rdfs:comment "Monitoring, tracking, or recording individuals' activities, communications, or locations without consent or legal authority in contexts where privacy is expected." .
